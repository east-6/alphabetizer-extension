{
  "manifest_version": 3,
  "name": "Alphabetizer",
  "version": "2.2",
  "description": "Sort text lines instantly with language-aware alphabetizing, dedupe, find and replace, and compare.",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": "icon48.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "scripting", "activeTab"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Open Alphabetizer"
    }
  }
}
